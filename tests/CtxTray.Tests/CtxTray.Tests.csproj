<Project Sdk="Microsoft.NET.Sdk">

  <!--
    本体（src/CtxTray）の判定ロジックを、画面を使わずに確かめる試験プログラム。
    配布物には含めない。実行すると結果を表示し、失敗があれば終了コード 1 を返す。
    本体のソースを直接取り込んでビルドする（UI の部分は取り込まない）。
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ctxtray-tests</AssemblyName>
    <RootNamespace>CtxTray.Tests</RootNamespace>
    <CodePage>65001</CodePage>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\..\src\CtxTray\Collect\*.cs" Link="Product\Collect\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\CtxTray\Config\*.cs" Link="Product\Config\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\CtxTray\Core\*.cs" Link="Product\Core\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\CtxTray\Native\NativeMethods.cs" Link="Product\Native\NativeMethods.cs" />
    <Compile Include="..\..\src\CtxTray\Notify\*.cs" Link="Product\Notify\%(Filename)%(Extension)" />
    <!-- 自動起動は、画面を使わない判定（ショートカットの指す先の比較）だけを試す。 -->
    <Compile Include="..\..\src\CtxTray\Ui\AutoStart.cs" Link="Product\Ui\AutoStart.cs" />
    <!-- 配色は、HUD とトレイが共有する色の規則（値の色と、注意・危険の色）だけを試す。 -->
    <Compile Include="..\..\src\CtxTray\Ui\Theme.cs" Link="Product\Ui\Theme.cs" />
  </ItemGroup>

</Project>
